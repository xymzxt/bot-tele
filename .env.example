# Telegram
BOT_TOKEN=123456:replace-with-your-telegram-bot-token
TELEGRAM_SECRET_TOKEN=replace-with-random-secret-for-webhook
PUBLIC_APP_URL=https://your-project.vercel.app

# Owner
OWNER_TELEGRAM_ID=123456789

# Security - use a long random string. It is hashed to AES-256 key internally.
ENCRYPTION_KEY=replace-with-very-long-random-secret-min-32-chars

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=telegram-dev-assistant

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_OAUTH_REDIRECT_URL=https://your-project.vercel.app/api/github/oauth

# Optional AI provider: OpenAI-compatible chat completions endpoint
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-ai-api-key
AI_MODEL=gpt-4o-mini

# Bot runtime
NODE_ENV=production
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
STATUS_CACHE_TTL_MS=15000
BOT_VERSION=0.1.0
APP_REGION=Singapore

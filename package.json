{
  "name": "bot-tele",
  "version": "0.1.0",
  "description": "Modern multi-user Bot Tele using Node.js, TypeScript, Telegraf, Vercel, Supabase, Cloudinary, and GitHub API.",
  "main": "api/webhook.ts",
  "scripts": {
    "dev": "tsx src/local.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "webhook:set": "tsx scripts/set-webhook.ts",
    "webhook:delete": "tsx scripts/delete-webhook.ts"
  },
  "keywords": [
    "telegram",
    "telegraf",
    "typescript",
    "vercel",
    "supabase",
    "github",
    "bot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "axios": "^1.7.9",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@vercel/node": "^5.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

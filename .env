# =====================================================
# DevOps Assistant Bot - Environment Configuration
# Copy this file to .env and fill in your values
# =====================================================

# ----- BOT CONFIGURATION -----
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=8537941372:AAF9OPzAnDGArxEfxmdbLHsgfsljrZIB9ug

# Bot owner Telegram ID (super administrator)
OWNER_ID=1236914597

# Bot username (without @)
BOT_USERNAME=@devops_manager_bot

# ----- DATABASE CONFIGURATION -----
# Default: SQLite | Production: PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres.kawefbetenefwcrujize:rahizel-bot@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/devops_bot

# ----- GITHUB API -----
# Personal Access Token from https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=
GITHUB_USERNAME=

# ----- DOCKER CONFIGURATION -----
DOCKER_HOST=unix:///var/run/docker.sock
# DOCKER_HOST=tcp://host:2375

# ----- VPS / SSH CONFIGURATION -----
SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=
SSH_KEY_PATH=

# ----- NOTIFICATION SETTINGS -----
CPU_THRESHOLD=90
RAM_THRESHOLD=90
DISK_THRESHOLD=85
MONITORING_INTERVAL=60

# ----- LOGGING -----
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ----- SECURITY -----
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate limiting (requests per minute per user)
RATE_LIMIT=30

# ----- APPLICATION -----
APP_ENV=production
DEBUG=False
TIMEZONE=Asia/Jakarta
LANGUAGE=id
